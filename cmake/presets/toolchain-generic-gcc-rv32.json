			}
		},
		{
			"name": "generic-gcc-rv32imf_zicsr_zifencei-debug-static",
			"inherits": [
				"generic-gcc-rv32imf_zicsr_zifencei-base",
				"build-type-debug"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "generic-gcc-rv32imf_zicsr_zifencei-release-static",
			"inherits": [
				"generic-gcc-rv32imf_zicsr_zifencei-base",
				"build-type-release"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		}
	]
