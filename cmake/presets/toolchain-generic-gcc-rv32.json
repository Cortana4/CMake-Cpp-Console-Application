{
	"version": 9,
	"include": [
		"base-presets.json",
		"build-presets.json"
	],
	"configurePresets": [
		{
			"name": "generic-gcc-rv32imf_zicsr_zifencei-base",
			"hidden": true,
			"inherits": [

			],
			"toolchainFile": "${sourceDir}/cmake/toolchains/generic-gcc-rv32.cmake",
			"cacheVariables": {
				"CMAKE_C_FLAGS": "-march=rv32imf_zicsr_zifencei -mabi=ilp32",
