{
	"version": 9,
	"include": [
		"base-presets.json",
		"build-presets.json",
		"vcpkg-targets-windows-mingw.json"
	],
	"configurePresets": [
		{
			"name": "windows-gcc-mingw-base",
			"hidden": true,
			"inherits": [
				"vcpkg-base"
			],
			"condition": {
				"type": "inList",
				"string": "${hostSystemName}",
				"list": [
					"Windows",
					"Linux"
				]
			}
		},
		{
			"name": "windows-gcc-mingw-x64-base",
			"hidden": true,
			"inherits": [
				"windows-gcc-mingw-base",
				"ext-arch-x64"
			],
			"cacheVariables": {
				"VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-gcc-mingw-x64.cmake"
			}
		},
		{
			"name": "windows-gcc-mingw-x86-base",
			"hidden": true,
			"inherits": [
				"windows-gcc-mingw-base",
				"ext-arch-x86"
			],
			"cacheVariables": {
				"VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-gcc-mingw-x86.cmake"
			}
		},
		{
			"name": "windows-gcc-mingw-x64-debug-dynamic",
			"inherits": [
				"windows-gcc-mingw-x64-base",
				"build-type-debug",
				"vcpkg-target-windows-mingw-x64-dynamic"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x64-debug-static",
			"inherits": [
				"windows-gcc-mingw-x64-base",
				"build-type-debug",
				"vcpkg-target-windows-mingw-x64-static"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x64-release-dynamic",
			"inherits": [
				"windows-gcc-mingw-x64-base",
				"build-type-release",
				"vcpkg-target-windows-mingw-x64-dynamic"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x64-release-static",
			"inherits": [
				"windows-gcc-mingw-x64-base",
				"build-type-release",
				"vcpkg-target-windows-mingw-x64-static"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x86-debug-dynamic",
			"inherits": [
				"windows-gcc-mingw-x86-base",
				"build-type-debug",
				"vcpkg-target-windows-mingw-x86-dynamic"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x86-debug-static",
			"inherits": [
				"windows-gcc-mingw-x86-base",
				"build-type-debug",
				"vcpkg-target-windows-mingw-x86-static"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x86-release-dynamic",
			"inherits": [
				"windows-gcc-mingw-x86-base",
				"build-type-release",
				"vcpkg-target-windows-mingw-x86-dynamic"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		},
		{
			"name": "windows-gcc-mingw-x86-release-static",
			"inherits": [
				"windows-gcc-mingw-x86-base",
				"build-type-release",
				"vcpkg-target-windows-mingw-x86-static"
			],
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/install/${presetName}"
		}
	]
}